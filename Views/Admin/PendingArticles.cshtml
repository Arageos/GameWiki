@model IEnumerable<GameWiki.Models.Article>
@{
    ViewData["Title"] = "Artykuły do weryfikacji";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold">📋 Artykuły do weryfikacji</h2>
            <p style="color:#64748b; margin:0; font-size:0.88rem;">Artykuły dodane przez użytkowników oczekujące na zatwierdzenie</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="gw-btn-outline" style="font-size:0.88rem;">← Panel admina</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="gw-auth-card" style="text-align:center; padding:3rem;">
            <div style="font-size:3rem; margin-bottom:1rem;">✅</div>
            <p style="color:#94a3b8;">Brak artykułów oczekujących na weryfikację.</p>
        </div>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:1rem;">
            @foreach (var article in Model)
            {
                <div class="gw-card" style="display:flex; gap:1.2rem; padding:1.2rem; align-items:flex-start;
                            background:#1a1d26; border-radius:12px; border:1px solid rgba(255,255,255,0.1);">

                    @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                    {
                        <img src="@article.CoverImageUrl" alt="Cover"
                             style="width:110px; height:70px; object-fit:cover; border-radius:8px;
                                    border:1px solid rgba(255,255,255,0.08); flex-shrink:0;" />
                    }
                    else
                    {
                        <div style="width:110px; height:70px; border-radius:8px; flex-shrink:0;
                                    background:rgba(99,102,241,0.12); border:1px solid rgba(99,102,241,0.2);
                                    display:flex; align-items:center; justify-content:center;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="#6366f1" stroke-width="1.5" width="32" height="32">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                            </svg>
                        </div>
                    }

                    <div style="flex:1; min-width:0;">
                        <div style="font-size:1rem; font-weight:700; color:#e2e8f0; margin-bottom:0.3rem;">
                            @article.Title
                            <span class="badge bg-warning text-dark ms-2" style="font-size:0.68rem; vertical-align:middle;">Niezweryfikowany</span>
                        </div>
                        <div style="display:flex; gap:1rem; font-size:0.8rem; color:#64748b; flex-wrap:wrap;">
                            <span>🎮 @article.Game?.Title</span>
                            <span>✍️ @article.Author?.Username</span>
                            <span>🕐 @DateTime.SpecifyKind(article.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:0.5rem; flex-shrink:0;">
                        <a asp-controller="Article" asp-action="Details" asp-route-id="@article.Id"
                           class="btn btn-sm btn-outline-secondary">
                            👁️ Podgląd
                        </a>
                        <form asp-controller="Article" asp-action="Verify" asp-route-id="@article.Id"
                              method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success w-100">✅ Zatwierdź</button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-danger w-100"
                                data-bs-toggle="modal" data-bs-target="#rejectArticleModal-@article.Id">
                            ❌ Odrzuć
                        </button>
                    </div>
                </div>

                <div class="modal fade" id="rejectArticleModal-@article.Id" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="background:#1a1d26; border:1px solid rgba(255,255,255,0.1);">
                            <div class="modal-header border-secondary">
                                <h5 class="modal-title text-white">Odrzuć artykuł</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-controller="Article" asp-action="Reject" asp-route-id="@article.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-body">
                                    <p class="text-secondary small mb-3">
                                        Autor <strong class="text-info">@article.Author?.Username</strong> otrzyma powiadomienie z podanym powodem. Tej operacji nie można cofnąć.
                                    </p>
                                    <label class="form-label text-light">Powód odrzucenia</label>
                                    <textarea name="deleteReason" class="form-control" rows="3"
                                              style="background:#0f1117; color:#e2e8f0; border-color:#334155;"
                                              placeholder="np. Artykuł niezgodny z tematyką serwisu, dezinformacja..."></textarea>
                                </div>
                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
                                    <button type="submit" class="btn btn-danger">Odrzuć artykuł</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>