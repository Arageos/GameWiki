@model IEnumerable<GameWiki.DTOs.Admin.ReportItemDto>
@{
    ViewData["Title"] = "Zgłoszenia Użytkowników";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold">🚩 Zgłoszone treści</h2>
            <p style="color:#64748b; margin:0; font-size:0.88rem;">Zgłoszenia oczekujące na rozpatrzenie</p>
        </div>
        <a asp-action="Index" class="gw-btn-outline" style="font-size:0.88rem;">← Panel admina</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="gw-auth-card" style="text-align:center; padding:3rem;">
            <div style="font-size:3rem; margin-bottom:1rem;">🎉</div>
            <p style="color:#94a3b8;">Brak oczekujących zgłoszeń. Społeczność zachowuje się wzorowo!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var report in Model)
            {
                <div class="col-12 mb-4">
                    <div class="gw-card p-4" style="background:#1a1d26; border-radius:12px; border-left:4px solid #f59e0b;">

                        <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                            <div style="display:flex; align-items:center; gap:0.7rem; flex-wrap:wrap;">
                                <span class="badge bg-warning text-dark text-uppercase">@report.Type.ToString()</span>
                                <span style="color:#94a3b8; font-size:0.85rem;">
                                    Zgłoszone przez: <strong style="color:#e2e8f0;">@report.ReporterName</strong>
                                    &nbsp;·&nbsp;
                                    @DateTime.SpecifyKind(report.CreatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <span style="color:#64748b; font-size:0.78rem; text-transform:uppercase; font-weight:600; letter-spacing:0.05em;">
                                Powód zgłoszenia:
                            </span>
                            <p style="color:#e2e8f0; font-style:italic; margin-top:0.3rem; margin-bottom:0;">
                                „@report.Reason"
                            </p>
                        </div>

                        @if (report.Type == GameWiki.Models.ReportType.Comment || report.Type == GameWiki.Models.ReportType.Review)
                        {
                            <div class="p-3 mb-4 rounded" style="background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08);">
                                <div style="font-size:0.8rem; margin-bottom:0.4rem;">
                                    <span style="color:#64748b;">Autor treści: </span>
                                    <strong style="color:#38bdf8;">@report.ContentAuthorName</strong>
                                </div>
                                <p style="color:#cbd5e1; margin:0; font-size:0.92rem;">@report.ContentText</p>
                            </div>
                        }

                        <div class="d-flex gap-2 flex-wrap">
                            @if (report.Type == GameWiki.Models.ReportType.Article)
                            {
                                <a href="/Article/Details/@report.TargetId" class="btn btn-sm btn-outline-info">
                                    👁️ Przejdź do artykułu
                                </a>
                            }

                            <form asp-action="HandleReport" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reportId" value="@report.ReportId" />
                                <input type="hidden" name="actionType" value="dismiss" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Zignoruj zgłoszenie</button>
                            </form>

                            @if (report.Type == GameWiki.Models.ReportType.Comment ||
                                 report.Type == GameWiki.Models.ReportType.Review ||
                                 report.Type == GameWiki.Models.ReportType.Article)
                            {
                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@report.ReportId">
                                    🗑️ Usuń treść
                                </button>

                                <div class="modal fade" id="deleteModal-@report.ReportId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content" style="background:#1a1d26; border:1px solid rgba(255,255,255,0.1);">
                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title text-white">
                                                    @(report.Type == GameWiki.Models.ReportType.Article
                                                        ? "Usuń artykuł"
                                                        : $"Usuń treść użytkownika {report.ContentAuthorName}")
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form asp-action="HandleReport" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-body">
                                                    <input type="hidden" name="reportId" value="@report.ReportId" />
                                                    <input type="hidden" name="actionType" value="delete" />
                                                    <p style="color:#94a3b8; font-size:0.85rem; margin-bottom:1rem;">
                                                        Użytkownik otrzyma powiadomienie z podanym powodem. Tej operacji nie można cofnąć.
                                                    </p>
                                                    <label class="form-label text-light">Powód usunięcia (widoczny dla autora)</label>
                                                    <textarea name="deleteReason" class="form-control" rows="3"
                                                              style="background:#0f1117; color:#e2e8f0; border-color:#334155;"
                                                              placeholder="np. Wulgaryzmy, spam, treści niezgodne z regulaminem..."></textarea>
                                                </div>
                                                <div class="modal-footer border-secondary">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Anuluj</button>
                                                    <button type="submit" class="btn btn-danger">Usuń treść</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>