@model IEnumerable<GameWiki.Models.Appeal>
@{
    ViewData["Title"] = "Panel Odwołań";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold">⚖️ Odwołania użytkowników</h2>
        <a asp-action="Index" class="btn btn-outline-light">Wróć do Panelu</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert text-center" style="background: rgba(255,255,255,0.05); color: #94a3b8; border: 1px dashed rgba(255,255,255,0.2);">
            Brak oczekujących odwołań. Wszystko jest na bieżąco!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var appeal in Model)
            {
                <div class="col-12 mb-4">
                    <div class="gw-card p-4" style="background: #1a1d26; border-radius: 12px; border-left: 4px solid #0dcaf0;">
                        <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                            <div>
                                <span class="badge bg-info text-dark me-2">@appeal.Subject</span>
                                <span class="text-muted small">
                                    Odwołujący się: <strong class="text-light">@appeal.User.Username</strong>
                                    &nbsp;·&nbsp; @appeal.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <span class="text-uppercase small fw-bold" style="color: #94a3b8;">Treść odwołania:</span>
                            <p class="text-white fst-italic mt-1">"@appeal.Message"</p>
                        </div>

                        <div class="d-flex gap-2">
                            <form asp-action="HandleAppeal" method="post" class="m-0">
                                <input type="hidden" name="appealId" value="@appeal.Id" />
                                <input type="hidden" name="actionType" value="approve" />
                                <button type="submit" class="btn btn-success btn-sm">Akceptuj i zamknij bilet</button>
                            </form>

                            <form asp-action="HandleAppeal" method="post" class="m-0">
                                <input type="hidden" name="appealId" value="@appeal.Id" />
                                <input type="hidden" name="actionType" value="reject" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Odrzuć odwołanie</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>