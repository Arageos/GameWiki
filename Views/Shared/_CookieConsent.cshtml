<div id="cookieConsent"
     style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999;
            background:rgba(15,17,23,0.97); border-top:1px solid rgba(99,102,241,0.4);
            backdrop-filter:blur(12px); padding:1.2rem 1.5rem;">
    <div style="max-width:1000px; margin:0 auto; display:flex; gap:1.5rem;
                align-items:center; flex-wrap:wrap; justify-content:space-between;">

        <div style="flex:1; min-width:260px;">
            <p style="margin:0 0 0.3rem; color:#e2e8f0; font-size:0.92rem; font-weight:600;">
                🍪 Ta strona używa plików cookies
            </p>
            <p style="margin:0; color:#94a3b8; font-size:0.82rem; line-height:1.5;">
                Używamy cookies sesyjnych niezbędnych do logowania. Możesz też zaakceptować
                opcjonalne cookies analityczne pomagające nam ulepszać serwis.
                <a asp-controller="Home" asp-action="Terms"
                   style="color:#818cf8; text-decoration:underline; font-size:0.82rem;">
                    Regulamin i polityka prywatności
                </a>
            </p>
        </div>

        <div style="display:flex; gap:0.6rem; flex-shrink:0; flex-wrap:wrap;">
            <button onclick="setConsent('rejected')"
                    style="padding:0.45rem 1rem; border-radius:8px; font-size:0.82rem; font-weight:600;
                           background:transparent; border:1px solid rgba(255,255,255,0.2);
                           color:#94a3b8; cursor:pointer; transition:all 0.2s;"
                    onmouseover="this.style.borderColor='rgba(255,255,255,0.5)'; this.style.color='#e2e8f0'"
                    onmouseout="this.style.borderColor='rgba(255,255,255,0.2)'; this.style.color='#94a3b8'">
                Odrzuć
            </button>
            <button onclick="setConsent('necessary')"
                    style="padding:0.45rem 1rem; border-radius:8px; font-size:0.82rem; font-weight:600;
                           background:transparent; border:1px solid #6366f1;
                           color:#818cf8; cursor:pointer; transition:all 0.2s;"
                    onmouseover="this.style.background='rgba(99,102,241,0.15)'"
                    onmouseout="this.style.background='transparent'">
                Tylko niezbędne
            </button>
            <button onclick="setConsent('all')"
                    style="padding:0.45rem 1.1rem; border-radius:8px; font-size:0.82rem; font-weight:600;
                           background:#6366f1; border:none; color:#fff; cursor:pointer; transition:all 0.2s;"
                    onmouseover="this.style.background='#4f46e5'"
                    onmouseout="this.style.background='#6366f1'">
                Akceptuj wszystkie
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        var banner = document.getElementById('cookieConsent');
        if (!localStorage.getItem('gw_consent')) {
            banner.style.display = 'block';
        }
    })();

    function setConsent(level) {
        localStorage.setItem('gw_consent', level);
        document.getElementById('cookieConsent').style.display = 'none';
    }
</script>
