@model GameWiki.DTOs.Game.GameIndexViewModel

@{
    ViewData["Title"] = "Games";
}

<div class="gw-section">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
        <div>
            <h1 class="gw-section-title">🎮 Games</h1>
            <p class="gw-section-sub">
                @if (Model.IsFiltered)
                {
                    <span>
                        Wyniki filtrowania —
                        <strong style="color:#a78bfa;">@Model.Games.Count()</strong> gier
                    </span>
                }
                else
                {
                    <span>Przeglądaj bazę gier</span>
                }
            </p>
        </div>

        <div style="display:flex; gap:0.8rem; align-items:center;">
            <button class="gw-btn-outline" id="filterToggleBtn" onclick="toggleFilter()">
                🔽 Filtruj
                @if (Model.IsFiltered)
                {
                    <span class="gw-filter-active-dot"></span>
                }
            </button>

            @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
            {
                <a asp-action="Create" class="gw-btn-primary">+ Dodaj grę</a>
            }
        </div>
    </div>

    <div id="filterPanel" class="gw-filter-panel @(Model.IsFiltered ? "open" : "")">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="gw-filter-grid">

                <div class="gw-form-group" style="margin:0; position:relative;">
                    <label class="gw-label">Szukaj po tytule</label>

                    <input type="text"
                           id="searchInput"
                           name="search"
                           value="@Model.Search"
                           class="gw-input"
                           placeholder="np. Wiedźmin..."
                           autocomplete="off" />

                    <div id="suggestions" class="gw-suggestions"></div>
                </div>

                <div class="gw-form-group" style="margin:0;">
                    <label class="gw-label">Gatunek</label>
                    <select name="genreId" class="gw-input gw-select">
                        <option value="">— Wszystkie —</option>
                        @foreach (var genre in Model.Genres)
                        {
                            if (Model.GenreId == genre.Id)
                            {
                                <option value="@genre.Id" selected>@genre.Name</option>
                            }
                            else
                            {
                                <option value="@genre.Id">@genre.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="gw-form-group" style="margin:0;">
                    <label class="gw-label">Platforma</label>
                    <select name="platformId" class="gw-input gw-select">
                        <option value="">— Wszystkie —</option>
                        @foreach (var platform in Model.Platforms)
                        {
                            if (Model.PlatformId == platform.Id)
                            {
                                <option value="@platform.Id" selected>@platform.Name</option>
                            }
                            else
                            {
                                <option value="@platform.Id">@platform.Name</option>
                            }
                        }
                    </select>
                </div>

            </div>

            <div style="display:flex; gap:0.8rem; margin-top:1.2rem;">
                <button type="submit" class="gw-btn-primary" style="padding:0.6rem 1.4rem;">
                    🔍 Szukaj
                </button>

                @if (Model.IsFiltered)
                {
                    <a asp-action="Index" class="gw-btn-outline" style="padding:0.6rem 1.4rem;">
                        ✕ Wyczyść filtry
                    </a>
                }
            </div>
        </form>
    </div>

    @if (!Model.Games.Any())
    {
        <div style="text-align:center; padding:4rem 0; color:#64748b;">
            <div style="font-size:3rem; margin-bottom:1rem;">🔍</div>
            <p style="font-size:1.1rem;">Nie znaleziono żadnych gier.</p>
            <a asp-action="Index" class="gw-btn-outline" style="margin-top:1rem; display:inline-block;">
                Wyczyść filtry
            </a>
        </div>
    }
    else
    {
        <div class="gw-games-grid">
            @foreach (var game in Model.Games)
            {
                <div class="gw-game-card">
                    <a asp-action="Details" asp-route-id="@game.Id" class="gw-game-banner-link">
                        @if (!string.IsNullOrEmpty(game.BackgroundImage))
                        {
                            <img src="@game.BackgroundImage" class="gw-game-banner" alt="@game.Title" />
                        }
                        else
                        {
                            <div class="gw-game-banner-placeholder">🎮</div>
                        }
                    </a>

                    <div class="gw-game-info">
                        <a asp-action="Details" asp-route-id="@game.Id" class="gw-game-title">
                            @game.Title
                        </a>

                        <span class="gw-game-date">
                            @game.ReleaseDate.ToString("yyyy")
                        </span>

                        <p class="gw-game-desc">
                            @{
                                var desc = game.Description ?? "";
                            }
                            @(desc.Length > 100 ? desc[..100] + "..." : desc)
                        </p>

                        @if (game.LocalRating.HasValue)
                        {
                            <div style="display:flex; align-items:center; gap:0.4rem;">
                                <div class="gw-stars-display">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="gw-star @(i <= Math.Round(game.LocalRating.Value) ? "filled" : "")">★</span>
                                    }
                                </div>
                                <span style="font-size:0.78rem; color:#64748b;">
                                    (@game.LocalRatingsCount)
                                </span>
                            </div>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <div class="gw-game-actions">
                                <a asp-action="Details" asp-route-id="@game.Id" class="gw-action-link gw-action-details">Szczegóły</a>
                                <span class="gw-action-sep">|</span>
                                <a asp-action="Edit" asp-route-id="@game.Id" class="gw-action-link gw-action-edit">Edytuj</a>
                                <span class="gw-action-sep">|</span>
                                <a asp-action="Delete" asp-route-id="@game.Id" class="gw-action-link gw-action-delete">Usuń</a>
                            </div>
                        }
                        else
                        {
                            <div class="gw-game-actions">
                                <a asp-action="Details" asp-route-id="@game.Id" class="gw-action-link gw-action-details">
                                    Szczegóły
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        function toggleFilter() {
            const panel = document.getElementById('filterPanel');
            const btn = document.getElementById('filterToggleBtn');
            const isOpen = panel.classList.toggle('open');

            btn.innerHTML = isOpen
                ? '🔼 Filtruj'
                : '🔽 Filtruj';

            @if (Model.IsFiltered)
            {
                    <text>
                    if (isOpen) {
                        btn.innerHTML += ' <span class="gw-filter-active-dot"></span>';
                    }
                    </text>
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            @if (Model.IsFiltered)
            {
                    <text>
                    document.getElementById('filterToggleBtn').innerHTML =
                        '🔼 Filtruj <span class="gw-filter-active-dot"></span>';
                    </text>
            }
        });
    </script>
    <script>
        console.log("INLINE AUTOCOMPLETE SCRIPT");

        document.addEventListener("DOMContentLoaded", function () {

            const input = document.getElementById("searchInput");
            const box = document.getElementById("suggestions");

            console.log("INPUT:", input);

            if (!input) return;

            input.addEventListener("input", async function () {

                const value = input.value;

                if (value.length < 2) {
                    box.innerHTML = "";
                    return;
                }

                const res = await fetch(`/Games/SearchTitles?term=${encodeURIComponent(value)}`);
                const data = await res.json();

                console.log("DATA:", data);

                box.innerHTML = "";

                data.forEach(title => {
                    const div = document.createElement("div");
                    div.textContent = title;

                    div.onclick = () => {
                        input.value = title;
                        box.innerHTML = "";
                        document.getElementById("filterForm").submit();
                    };

                    box.appendChild(div);
                });
            });
        });
    </script>
}